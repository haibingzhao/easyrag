# =========================================================
# EasyRAG 环境变量配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# =========================================================

# ---------- LLM（文档摘要 / 实体抽取 / 对话生成）----------
# 任何 OpenAI 兼容端点均可（OpenAI、DashScope、Ollama 的 /v1 等）
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
# DashScope 风格的思考模式开关（可选；false 关闭推理模型的思考输出）
LLM_ENABLE_THINKING=false
# 单次 LLM 请求超时秒数（默认 120；慢速推理模型可调大）
LLM_TIMEOUT_SECONDS=120

# ---------- 存储后端 ----------
# json   = 本地 JSON 文件（零外部依赖，开箱即用）
# memory = 纯内存（测试用）
# postgres = PostgreSQL + pgvector（生产推荐）
STORAGE_BACKEND=json
# PostgreSQL 连接（STORAGE_BACKEND=postgres 时必填）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-pg-password
PG_DATABASE=easyrag

# ---------- Embedding（向量化）----------
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- 知识图谱（可选，GRAPH_STORAGE_TYPE=neo4j 启用）----------
GRAPH_STORAGE_TYPE=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=100
# source_id 字符串→数组回填的每页行数（仅 Neo4j，启动时一次性执行；
# 工作区标记节点存在后即短路，稳态下不产生开销）。默认 1000。
# GRAPH_SOURCE_ID_MIGRATION_BATCH=1000

# ---------- 全文 / 混合检索（默认开启）----------
KEYWORD_SEARCH_ENABLED=true
# PostgreSQL tsvector 配置：simple / english / zhparser
KEYWORD_SEARCH_LANGUAGE=simple
KEYWORD_SEARCH_TOP_K=20
HYBRID_RRF_K=60

# ---------- 认证（默认开启）----------
# 服务器在 JWT_SECRET 为内置默认值或长度不足 32 字节时拒绝启动
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---------- 后台自动扫描（默认关闭）----------
AUTO_SCAN_ENABLED=false
AUTO_SCAN_INTERVAL_SECONDS=60
# 显式轮询任务：逗号分隔的 workspace[:biz_id[:interval_seconds]]
# AUTO_SCAN_TASKS=default,myws:biz-a,otherws::30
# 非空则额外启动增量目录扫描任务
AUTO_SCAN_INPUT_DIR=
AUTO_SCAN_EXTENSIONS=.txt,.md,.pdf
AUTO_SCAN_MAX_FILES_PER_CYCLE=100

# ---------- 流式摄入 Pipeline（默认关闭，灰度上线）----------
# 开启后用「持续发现 + 持续处理」的生产者-消费者模型替换一次性批处理：
# 新文档不再需要等待整批 join_all 完成即可被并发处理。
PIPELINE_STREAMING_ENABLED=false
# DocDiscovery 空闲轮询间隔（毫秒，自适应退避的下限）。默认 2000。
PIPELINE_POLL_INTERVAL_MS=2000
# 发现端与处理端之间有界 mpsc channel 的容量。默认 256。
PIPELINE_CHANNEL_CAPACITY=256
