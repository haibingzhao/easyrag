--- query[0] ---
MATCH (a:`test` {entity_id: $src, biz_id: $biz}), (b:`test` {entity_id: $tgt, biz_id: $biz}) MERGE (a)-[r:DIRECTED]->(b) SET r += $props, r.biz_id = $biz
--- params[0] ---
{
  "biz": "default",
  "src": "A",
  "tgt": "B",
  "props": {
    "relation": "knows"
  }
}
