--- query[0] ---
MATCH (a:`test` {biz_id: $biz})-[r:DIRECTED]->(b:`test` {biz_id: $biz}) WHERE ANY(c IN $chunks WHERE c IN r.source_id) RETURN a.entity_id AS src, b.entity_id AS tgt, properties(r) AS props
--- params[0] ---
{
  "biz": "default",
  "chunks": [
    "chunk-1",
    "chunk-2"
  ]
}
