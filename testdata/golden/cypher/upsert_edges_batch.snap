---
source: crates/easyrag-storage/tests/neo4j_graph_storage.rs
---
--- query[0] ---
UNWIND $items AS item MATCH (a:`test` {entity_id: item.src, biz_id: $biz}), (b:`test` {entity_id: item.tgt, biz_id: $biz}) MERGE (a)-[r:DIRECTED]->(b) SET r += item.props, r.biz_id = $biz
--- params[0] ---
{
  "biz": "default",
  "items": [
    {
      "src": "A",
      "tgt": "B",
      "props": {
        "rel": "r1"
      }
    },
    {
      "src": "C",
      "tgt": "D",
      "props": {
        "rel": "r2"
      }
    }
  ]
}
