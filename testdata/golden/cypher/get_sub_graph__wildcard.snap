--- query[0] ---
MATCH path = (start:`test` {entity_id: $label})-[:DIRECTED*0..2]-(connected:`test`) UNWIND nodes(path) AS n WITH DISTINCT n LIMIT $maxNodes RETURN n
--- params[0] ---
{
  "biz": "",
  "label": "A",
  "maxNodes": 10
}
--- query[1] ---
UNWIND $ids AS srcId MATCH (a:`test` {entity_id: srcId})-[r:DIRECTED]-(b:`test`) WHERE b.entity_id IN $ids RETURN DISTINCT a.entity_id AS src, b.entity_id AS tgt, r
--- params[1] ---
{
  "biz": "",
  "ids": [
    "A"
  ]
}
