on_event(document_failed)
on_document_failed(doc_id=d, file_path=, error=)
on_event(query_end)
on_query_end(query=q, mode=m, duration_ms=80)
on_event(batch_end)
on_batch_end(processed=1, failed=2, duration_ms=90)
