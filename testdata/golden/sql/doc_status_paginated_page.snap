---
source: crates/easyrag-storage/tests/postgres_storage.rs
---
SELECT id, biz_id, content, status, created_at, updated_at FROM doc_status_doc_status
             WHERE workspace = 'test_ws' AND biz_id = 'default' AND file_path LIKE '/data/%'
             ORDER BY updated_at DESC
             LIMIT 20 OFFSET 20
